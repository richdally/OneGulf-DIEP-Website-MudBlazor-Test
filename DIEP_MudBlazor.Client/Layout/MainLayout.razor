<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6" Class="ml-1">One Gulf</MudText>

        <MudSpacer />
        <!-- Simple top nav as buttons -->
        <!-- Use Primary so it picks up #500000 from the theme -->
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Home</MudButton>


    <MudMenu Label="Geospatial Dashboard"
             Color="Color.Primary"
             Variant="Variant.Filled"
             Dense="true"
             Class="ml-2">

        <MudMenuItem Href="/geospatial-dashboard">
            Overview
        </MudMenuItem>

        <MudMenuItem Href="/dashboard-1">
            Dashboard 1
        </MudMenuItem>

        <MudMenuItem Href="/dashboard-2">
            Dashboard 2
        </MudMenuItem>

    </MudMenu>

        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" Class="ml-3" />
    </MudAppBar>

    <!-- No drawer; just main content -->
    @* <MudMainContent Class="pt-16 p-4" Style="padding-bottom:64px;">
        <MudContainer MaxWidth="MaxWidth.False">
            @Body
        </MudContainer>
    </MudMainContent> *@

    <!-- All pages no max width -->
    <MudMainContent Class="pt-16 p-4" Style="padding-bottom:64px;">
        @Body
    </MudMainContent>

    <!-- Footer bar -->
    <MudDivider Class="mt-6" />
    <MudPaper Elevation="0" Class="py-3 px-4"
          Style="background-color:#324755; color:#ffffff;">
       <MudText Typo="Typo.caption" Class="text-center">
        Project Funded by: Texas OneGulf, GAD Number 7 (582-23-44892)
       </MudText>
    </MudPaper>

</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

